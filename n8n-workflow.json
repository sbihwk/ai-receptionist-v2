    {
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"gpt-4o-mini\",\n  \"temperature\": 0.7,\n  \"max_tokens\": 800,\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"You are Alex, the professional virtual assistant for {{ $json.businessName }}. You are handling a text conversation (SMS/WhatsApp).\\n\\nPERSONALITY: Warm, professional, concise. 2-3 sentences max. Never say you're an AI — say you're Alex, a virtual assistant.\\n\\nBUSINESS INFO:\\nName: {{ $json.businessName }}\\nPhone: {{ $json.businessPhone }}\\nDispatch Fee: {{ $json.dispatchFee }} (waived if repair completed same visit)\\nServices: HVAC, Plumbing, Electrical\\nMaintenance Plan: $199/year\\n\\nRULES:\\n- Never quote exact repair prices\\n- Collect: name, phone, address, service type, issue description, urgency\\n- For emergencies: tell them to call {{ $json.businessPhone }} immediately\\n- Use sales language for price inquiries\\n- For complaints: empathize and escalate\\n\\nPREVIOUS CONTEXT:\\n{{ $json.memoryContext }}\\n\\nRESPOND IN THIS EXACT JSON FORMAT:\\n{\\n  \\\"reply\\\": \\\"your message to the customer\\\",\\n  \\\"state\\\": \\\"NEW_BOOKING|EMERGENCY|RESCHEDULE|CANCELLATION|COMPLAINT|FAQ_ONLY|FOLLOW_UP|OTHER\\\",\\n  \\\"bookingData\\\": {\\n    \\\"name\\\": \\\"\\\",\\n    \\\"phone\\\": \\\"\\\",\\n    \\\"address\\\": \\\"\\\",\\n    \\\"serviceType\\\": \\\"\\\",\\n    \\\"issue\\\": \\\"\\\",\\n    \\\"urgency\\\": \\\"\\\"\\n  }\\n}\\n\\nONLY populate bookingData when you have enough info to save a booking. Always include reply and state.\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"From: {{ $('Normalize Input').item.json.from }}\\nChannel: {{ $('Normalize Input').item.json.channel }}\\nMessage: {{ $('Normalize Input').item.json.message }}\"\n    }\n  ]\n}",
        "options": {}
      },
      "id": "ai-brain",
      "name": "AI Brain - OpenAI",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1320, 300],
      "credentials": {
        "httpHeaderAuth": {
          "id": "openai-auth",
          "name": "OpenAI API Key"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const aiResponse = $input.first().json;\nlet content = '';\n\ntry {\n  content = aiResponse.choices[0].message.content;\n} catch (e) {\n  return [{ json: { reply: 'Thanks for reaching out! Please call us for immediate assistance.', state: 'OTHER', bookingData: null, parseError: true } }];\n}\n\nlet parsed;\ntry {\n  // Try to extract JSON from the response\n  const jsonMatch = content.match(/\\{[\\s\\S]*\\}/);\n  if (jsonMatch) {\n    parsed = JSON.parse(jsonMatch[0]);\n  } else {\n    parsed = { reply: content, state: 'OTHER', bookingData: null };\n  }\n} catch (e) {\n  parsed = { reply: content, state: 'OTHER', bookingData: null };\n}\n\nconst reply = parsed.reply || content || 'Thanks for your message! We\\'ll get back to you shortly.';\nconst state = parsed.state || 'OTHER';\nconst bookingData = parsed.bookingData || null;\n\nconst hasBookingData = bookingData && bookingData.name && bookingData.phone && bookingData.address && bookingData.serviceType;\n\nreturn [{\n  json: {\n    reply,\n    state,\n    bookingData: hasBookingData ? bookingData : null,\n    hasBookingData: !!hasBookingData,\n    from: $('Normalize Input').item.json.from,\n    channel: $('Normalize Input').item.json.channel,\n    conversationId: $('Normalize Input').item.json.conversationId,\n    message: $('Normalize Input').item.json.message,\n    businessName: $('Merge Context').item.json.businessName\n  }\n}];"
      },
      "id": "parse-classify",
      "name": "Parse & Classify Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1540, 300]
    },
    {
      "parameters": {
        "mode": "rules",
        "rules": {
          "values": [
            {
              "conditions": {
                "options": { "caseSensitive": false, "leftValue": "", "typeValidation": "loose" },
                "conditions": [
                  {
                    "leftValue": "={{ $json.state }}",
                    "rightValue": "NEW_BOOKING",
                    "operator": { "type": "string", "operation": "equals" }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputLabel": "New Booking"
            },
            {
              "conditions": {
                "options": { "caseSensitive": false, "leftValue": "", "typeValidation": "loose" },
                "conditions": [
                  {
                    "leftValue": "={{ $json.state }}",
                    "rightValue": "EMERGENCY",
                    "operator": { "type": "string", "operation": "equals" }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputLabel": "Emergency"
            },
            {
              "conditions": {
                "options": { "caseSensitive": false, "leftValue": "", "typeValidation": "loose" },
                "conditions": [
                  {
                    "leftValue": "={{ $json.state }}",
                    "rightValue": "COMPLAINT",
                    "operator": { "type": "string", "operation": "equals" }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputLabel": "Complaint"
            },
            {
              "conditions": {
                "options": { "caseSensitive": false, "leftValue": "", "typeValidation": "loose" },
                "conditions": [
                  {
                    "leftValue": "={{ $json.state }}",
                    "rightValue": "CANCELLATION",
                    "operator": { "type": "string", "operation": "equals" }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputLabel": "Cancellation"
            }
          ],
          "fallbackOutput": {
            "renameOutput": true,
            "outputLabel": "Default (FAQ/Other)"
          }
        },
        "options": {}
      },
