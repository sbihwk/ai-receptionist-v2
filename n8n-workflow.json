              "value": "={{ $json.body.ProfileName ? 'whatsapp' : ($json.body.SpeechResult ? 'voice' : 'sms') }}",
              "type": "string"
            },
            {
              "id": "set-conversationId",
              "name": "conversationId",
              "value": "={{ $json.body.From || $json.body.from || 'unknown' }}-{{ Date.now() }}",
