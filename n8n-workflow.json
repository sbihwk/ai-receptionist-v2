        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"gpt-4o-mini\",\n  \"temperature\": 0.3,\n  \"max_tokens\": 300,\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"Analyze this customer interaction and extract: sentiment (positive/neutral/negative), primary_issue, service_type, revenue_opportunity (high/medium/low/none), follow_up_needed (true/false). Respond in JSON only.\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"Customer message: {{ $json.message }}\\nAI response: {{ $json.reply }}\\nClassification: {{ $json.state }}\"\n    }\n  ]\n}",
